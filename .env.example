# Consumed by the postgres service on first boot (creates this user/password/db).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Full connection string, must reuse the three values above. Host must be
# "postgres" (the compose service name), not "localhost":
# postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL=

# Host must be "mosquitto" (the compose service name), not "localhost".
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=

# Browser origin allowed to call the API (decision 24). Local Vite only.
# Leave empty to disable CORS rather than opening every origin.
FRONTEND_ORIGIN=http://localhost:5173
